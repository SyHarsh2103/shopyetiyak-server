NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/grocery_platform

CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
CORS_CUSTOMER_ORIGIN=http://localhost:3000
CORS_ADMIN_ORIGIN=http://localhost:3001
COOKIE_DOMAIN=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Stripe test-mode server credentials for Phase 8.
# Never expose these values to the storefront.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 2 persistent local catalog image storage.
UPLOAD_PATH=./uploads

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=
