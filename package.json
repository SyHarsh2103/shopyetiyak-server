{
  "name": "grocery-server",
  "version": "0.17.0",
  "private": true,
  "description": "Backend API for the Grocery Commerce & Retail Operations Platform.",
  "type": "module",
  "engines": {
    "node": ">=24.6.0 <25",
    "npm": ">=11.5.1 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm install --include=dev --no-audit --no-fund && tsc -p tsconfig.build.json && npm prune --omit=dev --no-audit --no-fund",
    "build:local": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:local",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts",
    "db:indexes": "tsx src/scripts/create-indexes.ts",
    "seed:rbac": "tsx src/scripts/seed-rbac.ts",
    "notify:back-in-stock": "tsx src/scripts/dispatch-back-in-stock.ts",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "mongoose": "9.9.2",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "mongodb-memory-server": "11.2.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}